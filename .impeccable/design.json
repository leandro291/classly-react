  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de formularios y vacíos.",
      "html": "<button class=\"ds-btn-primary\">Crear clase</button>",
      "css": ".ds-btn-primary{background:#1a73e8;color:#fff;font:500 14px 'Roboto',sans-serif;padding:10px 24px;border:0;border-radius:8px;cursor:pointer;transition:background-color .15s}.ds-btn-primary:hover{background:#1557b0}.ds-btn-primary:focus-visible{outline:2px solid #1a73e8;outline-offset:2px}.ds-btn-primary:active{background:#1557b0}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Cancelar y acciones secundarias.",
      "html": "<button class=\"ds-btn-text\">Cancelar</button>",
      "css": ".ds-btn-text{background:transparent;color:#1a73e8;font:500 14px 'Roboto',sans-serif;padding:8px 16px;border:0;border-radius:8px;cursor:pointer;transition:background-color .15s}.ds-btn-text:hover{background:#e8f0fe}.ds-btn-text:focus-visible{outline:2px solid #1a73e8;outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Confirmación de eliminación o retiro.",
      "html": "<button class=\"ds-btn-danger\">Eliminar</button>",
      "css": ".ds-btn-danger{background:#d93025;color:#fff;font:500 14px 'Roboto',sans-serif;padding:8px 20px;border:0;border-radius:8px;cursor:pointer;transition:background-color .15s}.ds-btn-danger:hover{background:#b31412}.ds-btn-danger:focus-visible{outline:2px solid #d93025;outline-offset:2px}"
    },
    {
      "name": "Floating Label Input",
      "kind": "input",
      "refersTo": "input-field",
      "description": "Campo con etiqueta flotante y anillo de foco azul.",
      "html": "<div class=\"ds-field\"><input class=\"ds-input\" placeholder=\" \" value=\"Matemática 3°B\"><label class=\"ds-label\">Nombre de la clase</label></div>",
      "css": ".ds-field{position:relative;width:260px}.ds-input{width:100%;box-sizing:border-box;border:1px solid #80868b;border-radius:8px;padding:24px 12px 8px;font:400 14px 'Roboto',sans-serif;color:#202124;outline:none;background:#fff;transition:all .15s}.ds-input:focus{border-color:#1a73e8;box-shadow:0 0 0 1px #1a73e8}.ds-label{position:absolute;left:12px;top:6px;font:400 12px 'Roboto',sans-serif;color:#5f6368;pointer-events:none;transition:all .15s}.ds-input:focus+.ds-label{color:#1a73e8}"
    },
    {
      "name": "Status Chip",
      "kind": "chip",
      "refersTo": "chip-status",
      "description": "Estado de tarea: a tiempo, pronto, vencida, entregada.",
      "html": "<span class=\"ds-chip\">5 días</span> <span class=\"ds-chip ds-chip-warn\">Mañana</span> <span class=\"ds-chip ds-chip-bad\">Vencida</span> <span class=\"ds-chip ds-chip-ok\">Entregada</span>",
      "css": ".ds-chip{display:inline-block;font:500 12px 'Roboto',sans-serif;padding:2px 8px;border-radius:9999px;background:#f1f3f4;color:#5f6368}.ds-chip-warn{background:#fef7e0;color:#9a5400}.ds-chip-bad{background:#fce8e6;color:#c5221f}.ds-chip-ok{background:#e6f4ea;color:#137333}"
    },
    {
      "name": "Course Card",
      "kind": "card",
      "refersTo": "card-course",
      "description": "Tarjeta del panel: cabecera de color de curso, profesor y acciones.",
      "html": "<div class=\"ds-course\"><div class=\"ds-course-head\"><h3 class=\"ds-course-title\">Biología 2°A</h3><p class=\"ds-course-sub\">2026 · Semestre 2</p></div><div class=\"ds-course-body\"><p class=\"ds-course-teacher\">Ana Pérez</p></div></div>",
      "css": ".ds-course{width:260px;background:#fff;border:1px solid #e0e0e0;border-radius:12px;overflow:hidden;box-shadow:0 1px 3px 0 rgb(0 0 0/.1),0 1px 2px -1px rgb(0 0 0/.1);cursor:pointer;transition:box-shadow .15s}.ds-course:hover{box-shadow:0 4px 6px -1px rgb(0 0 0/.1),0 2px 4px -2px rgb(0 0 0/.1)}.ds-course-head{height:96px;box-sizing:border-box;padding:16px 16px 8px;background:#1a7d37}.ds-course-title{margin:0;font:500 18px/1.25 'Google Sans','Roboto',sans-serif;color:#fff}.ds-course-sub{margin:2px 0 0;font:400 12px 'Roboto',sans-serif;color:#fff}.ds-course-body{padding:12px 16px}.ds-course-teacher{margin:0;font:400 12px 'Roboto',sans-serif;color:#5f6368}"
    },
    {
      "name": "Task Row",
      "kind": "card",
      "refersTo": "card-surface",
      "description": "Fila de tarea: círculo de icono, título, fecha y chip de estado.",
